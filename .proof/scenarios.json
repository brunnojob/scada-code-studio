{
  "repository": "brunnojob/scada-code-studio",
  "inputs": [
    ".proof/scenarios.json"
  ],
  "cases": [
    {
      "name": "npm ci",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm ci"
      ],
      "timeout": 900,
      "display": false
    },
    {
      "name": "npm run build",
      "argv": [
        "bash",
        "-e",
        "-o",
        "pipefail",
        "-c",
        "npm run build"
      ],
      "timeout": 900,
      "display": true
    }
  ]
}
